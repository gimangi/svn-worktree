{
  "name": "svn-worktree",
  "displayName": "SVN Worktree (svnwt)",
  "description": "SVN working copy에서 작업 단위 git worktree, PR 형태의 리뷰, 작업별 SVN changelist를 제공하고 Copilot에 MCP 도구로 노출합니다.",
  "version": "0.5.3",
  "publisher": "svnwt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "SCM Providers",
    "AI",
    "Other"
  ],
  "keywords": [
    "svn",
    "subversion",
    "worktree",
    "copilot",
    "mcp"
  ],
  "main": "./src/ext/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "svnwt",
        "label": "SVN Worktree"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "svnwt",
          "title": "SVN Worktree",
          "icon": "media/svnwt.svg"
        }
      ]
    },
    "views": {
      "svnwt": [
        {
          "id": "svnwt.tasks",
          "name": "작업",
          "icon": "media/svnwt.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "svnwt.tasks",
        "contents": "SVN working copy 안의 폴더를 scope로 등록하면 작업(task)마다 별도 worktree에서 작업할 수 있습니다.\n[폴더를 scope로 등록](command:svnwt.initScope)\n[환경 점검 (Git / SVN)](command:svnwt.checkEnvironment)"
      }
    ],
    "commands": [
      {
        "command": "svnwt.refresh",
        "title": "새로 고침",
        "category": "SVN Worktree",
        "icon": "$(refresh)"
      },
      {
        "command": "svnwt.checkSvn",
        "title": "SVN 지금 확인 (서버 새 커밋 · 기준 갱신 · 커밋 완료)",
        "category": "SVN Worktree",
        "icon": "$(cloud-download)"
      },
      {
        "command": "svnwt.addRule",
        "title": "규칙 추가",
        "category": "SVN Worktree",
        "icon": "$(add)"
      },
      {
        "command": "svnwt.editRule",
        "title": "규칙 수정",
        "category": "SVN Worktree",
        "icon": "$(edit)"
      },
      {
        "command": "svnwt.removeRule",
        "title": "규칙 삭제",
        "category": "SVN Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "svnwt.openRulesFile",
        "title": "규칙 지침 파일 열기",
        "category": "SVN Worktree",
        "icon": "$(go-to-file)"
      },
      {
        "command": "svnwt.initScope",
        "title": "폴더를 scope로 등록",
        "category": "SVN Worktree",
        "icon": "$(root-folder)"
      },
      {
        "command": "svnwt.refreshScope",
        "title": "SVN 기준 다시 읽기",
        "category": "SVN Worktree",
        "icon": "$(sync)"
      },
      {
        "command": "svnwt.svnUpdateScope",
        "title": "svn update 후 기준 갱신",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.removeScope",
        "title": "scope 등록 해제",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.createTask",
        "title": "새 작업 (직접)",
        "category": "SVN Worktree",
        "icon": "$(add)"
      },
      {
        "command": "svnwt.openReview",
        "title": "리뷰 열기",
        "category": "SVN Worktree",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "svnwt.openReviewNewTab",
        "title": "리뷰를 새 탭으로 열기",
        "category": "SVN Worktree",
        "icon": "$(link-external)"
      },
      {
        "command": "svnwt.openChanges",
        "title": "모든 변경 사항 보기",
        "category": "SVN Worktree",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "svnwt.askCopilotReview",
        "title": "Copilot에게 리뷰 요청",
        "category": "SVN Worktree",
        "icon": "$(copilot)"
      },
      {
        "command": "svnwt.syncTask",
        "title": "최신 SVN 기준으로 rebase",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.land",
        "title": "SVN changelist 만들기/갱신",
        "category": "SVN Worktree",
        "icon": "$(checklist)"
      },
      {
        "command": "svnwt.rebaseAndLand",
        "title": "최신 SVN 기준으로 rebase 후 changelist 만들기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.unland",
        "title": "SVN working copy에서 되돌리기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.commitSvn",
        "title": "SVN 커밋…",
        "category": "SVN Worktree",
        "icon": "$(repo-push)"
      },
      {
        "command": "svnwt.commitSvnChoose",
        "title": "SVN 커밋 (방법 선택)…",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.cancelCommit",
        "title": "커밋 준비 취소 (되돌리기)",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.discardLeftovers",
        "title": "남은 변경 버리기 (커밋에서 빠진 파일)",
        "category": "SVN Worktree",
        "icon": "$(discard)"
      },
      {
        "command": "svnwt.copyCommitCommand",
        "title": "svn commit 명령 복사",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.openWorktree",
        "title": "worktree 열기…",
        "category": "SVN Worktree",
        "icon": "$(folder-opened)"
      },
      {
        "command": "svnwt.addToWorkspace",
        "title": "worktree를 작업 영역에 추가",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.openInNewWindow",
        "title": "worktree를 새 창에서 열기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.revealWorktree",
        "title": "파일 탐색기에서 worktree 열기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.openTerminal",
        "title": "worktree에서 터미널 열기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.removeTask",
        "title": "작업 보관 (worktree 정리, 커밋 기록 유지)",
        "category": "SVN Worktree",
        "icon": "$(archive)"
      },
      {
        "command": "svnwt.checkEnvironment",
        "title": "환경 점검 (Git / SVN)",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.installInstructions",
        "title": "Copilot 지침 다시 설치",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.exportVisualStudio",
        "title": "Visual Studio용 MCP 설정 내보내기",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.agent.newTask",
        "title": "새 작업 (에이전트에게 맡기기)",
        "category": "SVN Worktree",
        "icon": "$(sparkle)"
      },
      {
        "command": "svnwt.agent.instruct",
        "title": "에이전트에게 지시…",
        "category": "SVN Worktree",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "svnwt.agent.stop",
        "title": "에이전트 중지",
        "category": "SVN Worktree",
        "icon": "$(debug-stop)"
      },
      {
        "command": "svnwt.agent.openChat",
        "title": "채팅에서 이어가기 (@svnwt)",
        "category": "SVN Worktree",
        "icon": "$(comment)"
      },
      {
        "command": "svnwt.agent.enableChatSessions",
        "title": "Chat 세션 목록에 작업 표시 (실험)",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.locks",
        "title": "잠금 상태 확인/해제",
        "category": "SVN Worktree"
      },
      {
        "command": "svnwt.askAboutSelection",
        "title": "이 부분 질문/수정 지시…",
        "category": "SVN Worktree",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "svnwt.refreshPrepare",
        "title": "커밋 준비 갱신 (새 커밋 반영)",
        "category": "SVN Worktree",
        "icon": "$(sync)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.purgeTask",
        "title": "보관 기록 삭제",
        "icon": "$(trash)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.showArchived",
        "title": "보관된 작업 검색…",
        "icon": "$(search)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.discardScopeChanges",
        "title": "SVN 남은 변경 정리…",
        "icon": "$(discard)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.prevFile",
        "title": "이전 변경 파일",
        "icon": "$(chevron-left)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.nextFile",
        "title": "다음 변경 파일",
        "icon": "$(chevron-right)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.backToReview",
        "title": "리뷰 화면으로",
        "icon": "$(git-pull-request)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.diffToWindow",
        "title": "diff 를 새 창으로 분리 (다음에도 새 창에)",
        "icon": "$(multiple-windows)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.diffToReview",
        "title": "diff 를 리뷰 화면 탭으로 (다음에도 리뷰 화면 위에)",
        "icon": "$(screen-normal)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.nextChange",
        "title": "다음 변경 (파일 끝에서는 다음 파일로)",
        "icon": "$(arrow-right)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.prevChange",
        "title": "이전 변경 (파일 처음에서는 이전 파일로)",
        "icon": "$(arrow-left)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.renameTask",
        "title": "작업 이름 변경…",
        "icon": "$(edit)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.showShortcuts",
        "title": "단축키 보기·바꾸기",
        "icon": "$(keyboard)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.applyLocal",
        "title": "로컬에 반영 (빌드까지)",
        "icon": "$(beaker)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.endLocal",
        "title": "로컬 반영 되돌리기",
        "icon": "$(discard)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.rebuildLocal",
        "title": "로컬 반영 다시 빌드",
        "icon": "$(tools)"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.setLocalBuild",
        "title": "로컬 반영 빌드 명령 설정…"
      },
      {
        "category": "SVN Worktree",
        "command": "svnwt.localApplyMenu",
        "title": "로컬 반영 메뉴"
      },
      {
        "command": "svnwt.reopenTask",
        "title": "커밋 완료 취소 (진행 중으로 되돌리기)",
        "category": "SVN Worktree",
        "icon": "$(debug-step-back)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "svnwt.agent.newTask",
          "when": "view == svnwt.tasks",
          "group": "navigation@0"
        },
        {
          "command": "svnwt.createTask",
          "when": "view == svnwt.tasks",
          "group": "navigation@1"
        },
        {
          "command": "svnwt.refresh",
          "when": "view == svnwt.tasks",
          "group": "navigation@2"
        },
        {
          "command": "svnwt.initScope",
          "when": "view == svnwt.tasks",
          "group": "1@1"
        },
        {
          "command": "svnwt.checkEnvironment",
          "when": "view == svnwt.tasks",
          "group": "z@1"
        },
        {
          "command": "svnwt.installInstructions",
          "when": "view == svnwt.tasks",
          "group": "z@2"
        },
        {
          "command": "svnwt.showShortcuts",
          "when": "view == svnwt.tasks",
          "group": "z@3"
        },
        {
          "command": "svnwt.exportVisualStudio",
          "when": "view == svnwt.tasks",
          "group": "z@3"
        },
        {
          "command": "svnwt.agent.enableChatSessions",
          "when": "view == svnwt.tasks",
          "group": "z@4"
        },
        {
          "command": "svnwt.locks",
          "when": "view == svnwt.tasks",
          "group": "z@0"
        },
        {
          "command": "svnwt.checkSvn",
          "when": "view == svnwt.tasks",
          "group": "z@0"
        }
      ],
      "view/item/context": [
        {
          "command": "svnwt.renameTask",
          "when": "view == svnwt.tasks && viewItem =~ /^task[.]/",
          "group": "8@1"
        },
        {
          "command": "svnwt.addRule",
          "when": "view == svnwt.tasks && viewItem == rules",
          "group": "inline@0"
        },
        {
          "command": "svnwt.openRulesFile",
          "when": "view == svnwt.tasks && viewItem == rules",
          "group": "inline@1"
        },
        {
          "command": "svnwt.editRule",
          "when": "view == svnwt.tasks && viewItem == rule",
          "group": "inline@0"
        },
        {
          "command": "svnwt.removeRule",
          "when": "view == svnwt.tasks && viewItem == rule",
          "group": "inline@1"
        },
        {
          "command": "svnwt.agent.newTask",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "inline@0"
        },
        {
          "command": "svnwt.agent.newTask",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "1@0"
        },
        {
          "command": "svnwt.agent.stop",
          "when": "view == svnwt.tasks && viewItem =~ /\\.running$/",
          "group": "inline@0"
        },
        {
          "command": "svnwt.agent.instruct",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed)$/",
          "group": "0@1"
        },
        {
          "command": "svnwt.agent.openChat",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed)/",
          "group": "0@2"
        },
        {
          "command": "svnwt.agent.stop",
          "when": "view == svnwt.tasks && viewItem =~ /\\.running$/",
          "group": "0@3"
        },
        {
          "command": "svnwt.createTask",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "inline@1"
        },
        {
          "command": "svnwt.createTask",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "1@1"
        },
        {
          "command": "svnwt.svnUpdateScope",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "1@3"
        },
        {
          "command": "svnwt.removeScope",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "9@1"
        },
        {
          "command": "svnwt.land",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.active/",
          "group": "inline@1"
        },
        {
          "command": "svnwt.commitSvn",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.landed/",
          "group": "inline@1"
        },
        {
          "command": "svnwt.removeTask",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.committed/",
          "group": "inline@1"
        },
        {
          "command": "svnwt.openReview",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\./",
          "group": "1@1"
        },
        {
          "command": "svnwt.openChanges",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\./",
          "group": "1@2"
        },
        {
          "command": "svnwt.askCopilotReview",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed)/",
          "group": "1@3"
        },
        {
          "command": "svnwt.land",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed)/",
          "group": "2@1"
        },
        {
          "command": "svnwt.commitSvn",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.landed/",
          "group": "2@2"
        },
        {
          "command": "svnwt.unland",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.landed/",
          "group": "2@4"
        },
        {
          "command": "svnwt.discardLeftovers",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.committed\\.leftovers/",
          "group": "2@5"
        },
        {
          "command": "svnwt.openWorktree",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed|committed)/",
          "group": "3@1"
        },
        {
          "command": "svnwt.removeTask",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.(active|landed|committed)/",
          "group": "9@1"
        },
        {
          "command": "svnwt.discardScopeChanges",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "1@4"
        },
        {
          "command": "svnwt.discardScopeChanges",
          "when": "view == svnwt.tasks && viewItem =~ /^task\\.committed/",
          "group": "2@6"
        },
        {
          "command": "svnwt.showArchived",
          "when": "view == svnwt.tasks && viewItem == archive",
          "group": "inline@0"
        },
        {
          "command": "svnwt.purgeTask",
          "when": "view == svnwt.tasks && viewItem == task.archived",
          "group": "9@1"
        },
        {
          "command": "svnwt.applyLocal",
          "when": "view == svnwt.tasks && viewItem =~ /^task.active/",
          "group": "inline@0"
        },
        {
          "command": "svnwt.applyLocal",
          "when": "view == svnwt.tasks && viewItem =~ /^task.(active|landed)/",
          "group": "2@0"
        },
        {
          "command": "svnwt.commitSvn",
          "when": "view == svnwt.tasks && viewItem =~ /^task.local/",
          "group": "inline@1"
        },
        {
          "command": "svnwt.endLocal",
          "when": "view == svnwt.tasks && viewItem =~ /^task.local/",
          "group": "inline@2"
        },
        {
          "command": "svnwt.commitSvn",
          "when": "view == svnwt.tasks && viewItem =~ /^task.local/",
          "group": "2@1"
        },
        {
          "command": "svnwt.rebuildLocal",
          "when": "view == svnwt.tasks && viewItem =~ /^task.local/",
          "group": "2@2"
        },
        {
          "command": "svnwt.endLocal",
          "when": "view == svnwt.tasks && viewItem =~ /^task.local/",
          "group": "2@3"
        },
        {
          "command": "svnwt.setLocalBuild",
          "when": "view == svnwt.tasks && viewItem == scope",
          "group": "5@9"
        },
        {
          "command": "svnwt.reopenTask",
          "when": "view == svnwt.tasks && viewItem =~ /^task.committed/",
          "group": "8@2"
        }
      ],
      "explorer/context": [
        {
          "command": "svnwt.initScope",
          "when": "explorerResourceIsFolder",
          "group": "7_svnwt@1"
        }
      ],
      "commandPalette": [
        {
          "command": "svnwt.renameTask",
          "when": "false"
        },
        {
          "command": "svnwt.editRule",
          "when": "false"
        },
        {
          "command": "svnwt.removeRule",
          "when": "false"
        },
        {
          "command": "svnwt.addToWorkspace",
          "when": "false"
        },
        {
          "command": "svnwt.revealWorktree",
          "when": "false"
        },
        {
          "command": "svnwt.openInNewWindow",
          "when": "false"
        },
        {
          "command": "svnwt.openTerminal",
          "when": "false"
        },
        {
          "command": "svnwt.copyCommitCommand",
          "when": "false"
        },
        {
          "command": "svnwt.refresh",
          "when": "false"
        },
        {
          "command": "svnwt.agent.stop",
          "when": "false"
        },
        {
          "command": "svnwt.askAboutSelection",
          "when": "svnwt.inTask"
        },
        {
          "command": "svnwt.prevFile",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.nextFile",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.backToReview",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.diffToWindow",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.diffToReview",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.nextChange",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.prevChange",
          "when": "svnwt.diffNav"
        },
        {
          "command": "svnwt.localApplyMenu",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "svnwt.askAboutSelection",
          "when": "svnwt.inTask",
          "group": "navigation@0"
        }
      ],
      "editor/title": [
        {
          "command": "svnwt.askAboutSelection",
          "when": "svnwt.inTask",
          "group": "navigation@0"
        },
        {
          "command": "svnwt.prevChange",
          "when": "svnwt.diffNav",
          "group": "navigation@-5"
        },
        {
          "command": "svnwt.nextChange",
          "when": "svnwt.diffNav",
          "group": "navigation@-4"
        },
        {
          "command": "svnwt.prevFile",
          "when": "svnwt.diffNav",
          "group": "navigation@-3"
        },
        {
          "command": "svnwt.nextFile",
          "when": "svnwt.diffNav",
          "group": "navigation@-2"
        },
        {
          "command": "svnwt.backToReview",
          "when": "svnwt.diffNav",
          "group": "navigation@-1"
        },
        {
          "command": "svnwt.diffToWindow",
          "when": "svnwt.diffNav && config.svnwt.diffPlacement != 'window'",
          "group": "navigation@0"
        },
        {
          "command": "svnwt.diffToReview",
          "when": "svnwt.diffNav && config.svnwt.diffPlacement == 'window'",
          "group": "navigation@0"
        },
        {
          "command": "svnwt.showShortcuts",
          "when": "activeWebviewPanelId == 'svnwt.review'",
          "group": "navigation@9"
        },
        {
          "command": "svnwt.showShortcuts",
          "when": "svnwt.diffNav",
          "group": "svnwt@1"
        }
      ]
    },
    "configuration": {
      "title": "SVN Worktree",
      "properties": {
        "svnwt.gitPath": {
          "type": "string",
          "default": "",
          "description": "git.exe 경로. 비우면 PATH와 Git for Windows 기본 설치 위치에서 찾습니다."
        },
        "svnwt.svnPath": {
          "type": "string",
          "default": "",
          "description": "svn.exe 경로. 비우면 PATH, TortoiseSVN, SlikSVN 기본 위치에서 찾습니다."
        },
        "svnwt.addWorktreeToWorkspace": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "always",
          "description": "Copilot(MCP)이 작업을 만들면 해당 worktree 폴더를 현재 작업 영역에 추가합니다. Copilot이 worktree 파일을 편집하려면 작업 영역에 있어야 합니다."
        },
        "svnwt.installCopilotInstructions": {
          "type": "boolean",
          "default": true,
          "description": "VS Code 사용자 프로필에 Copilot 지침 파일(svnwt.instructions.md)을 설치해 모든 작업 영역에서 svnwt 워크플로를 따르도록 합니다."
        },
        "svnwt.commitTool": {
          "type": "string",
          "enum": [
            "prepare",
            "tortoise",
            "vscode",
            "ask"
          ],
          "enumDescriptions": [
            "커밋 준비만 함: TortoiseSVN 커밋 창을 직접 열면 이 작업 파일만 체크돼 있도록 정리하고, 커밋이 감지되면 자동으로 원상복구",
            "TortoiseSVN 커밋 창을 직접 띄움 (이 작업 파일과 커밋 메시지가 채워진 상태)",
            "VS Code 확인 창에서 바로 svn commit",
            "매번 선택"
          ],
          "default": "prepare",
          "description": "\"SVN 커밋…\" 동작. 어느 방법이든 이 작업의 변경만 커밋되도록 다른 변경은 잠시 빼 두었다가 되돌립니다."
        },
        "svnwt.agent.model": {
          "type": "string",
          "default": "",
          "description": "백그라운드 에이전트가 쓸 Copilot 모델 (id/family 일부, 예: claude-sonnet, gpt-4.1). 비우면 자동 선택. 채팅(@svnwt)에서는 채팅 창에서 고른 모델을 씁니다."
        },
        "svnwt.agent.commandApproval": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "enumDescriptions": [
            "명령마다 확인 (작업별 \"항상 허용\" 가능)",
            "확인 없이 실행 (worktree 안, svn 쓰기 명령은 항상 차단)"
          ],
          "default": "ask",
          "description": "에이전트의 run_command 실행 승인 방식"
        },
        "svnwt.agent.newFileEol": {
          "type": "string",
          "enum": [
            "crlf",
            "lf"
          ],
          "default": "crlf",
          "description": "에이전트가 새로 만드는 파일의 줄바꿈 (기존 파일은 원래 형식 유지)"
        },
        "svnwt.agent.chatSessions": {
          "type": "boolean",
          "default": false,
          "description": "(실험) VS Code Chat 세션 목록에 svnwt 작업을 표시. VS Code 제안 API 가 필요해 \"SVN Worktree: Chat 세션 목록에 작업 표시 (실험)\" 명령으로 켭니다."
        },
        "svnwt.reviewAskTarget": {
          "type": "string",
          "enum": [
            "chat",
            "copilot",
            "background"
          ],
          "enumDescriptions": [
            "Copilot Chat 에 \"@svnwt /continue <번호>\" 로 보냄: 그 작업의 에이전트 세션에서 이어서 진행 (채팅에 보임)",
            "Copilot Chat 기본 에이전트에 작업 번호·worktree 와 함께 보냄 (MCP 도구 사용)",
            "백그라운드 에이전트 세션에 보냄 (리뷰 화면의 에이전트 세션에 보임)"
          ],
          "default": "chat",
          "description": "\"이 부분 질문/수정 지시\" 요청을 보낼 곳. 선택한 코드, 파일·줄 위치, 그 부분의 작업 diff 가 함께 들어갑니다."
        },
        "svnwt.svnWatch": {
          "type": "boolean",
          "default": true,
          "description": "SVN working copy 를 백그라운드에서 확인합니다 (1분마다, VS Code 창으로 돌아올 때 svn info 한 번). TortoiseSVN 으로 update 하면 SVN 기준을 다시 읽고, 진행 중인 작업을 새 기준으로 rebase 할지 묻습니다. 직접 커밋한 changelist 작업은 커밋 완료로 표시합니다."
        },
        "svnwt.svnServerCheckMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "SVN 서버에 scope 폴더의 새 커밋이 있는지 확인하는 간격(분). 남이 커밋한 것이 있으면 svn update 할지 묻습니다. 0 이면 확인하지 않습니다 (svnwt.svnWatch 가 켜져 있을 때)."
        },
        "svnwt.diffPlacement": {
          "type": "string",
          "enum": [
            "review",
            "window",
            "beside"
          ],
          "enumDescriptions": [
            "리뷰 화면 위(같은 탭 그룹)에 전체 폭으로 엽니다 (양쪽 비교). 제목줄의 이전/다음 파일, 리뷰 화면 버튼으로 이동",
            "diff 전용 새 창에 엽니다. 다음 파일도 그 창에서 바뀝니다",
            "리뷰 화면 옆 칸에 엽니다 (좁으면 VS Code 가 한 줄 diff 로 바꿈)"
          ],
          "default": "review",
          "description": "변경 파일을 눌렀을 때 diff 를 여는 위치. diff 제목줄의 \"새 창으로 분리\" / \"리뷰 화면 탭으로\" 버튼을 누르면 그 방식이 여기에 저장되어 다음에도 같은 방식으로 열립니다."
        },
        "svnwt.localApply.agentRequests": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "에이전트가 로컬 반영(테스트)을 요청하면 반영할지 묻습니다 (예 / 아니요 / 항상)",
            "묻지 않고 반영합니다",
            "반영하지 않고 거절합니다"
          ],
          "description": "에이전트(svnwt_test_request)가 작업을 SVN working copy 에 반영해 테스트하려고 할 때. 반영하는 동안 다른 로컬 변경은 빼 두었다가 테스트가 끝나면 되돌립니다."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "svnwt.agent",
        "name": "svnwt",
        "fullName": "SVN Worktree",
        "description": "작업별 worktree 에서 일하는 에이전트 (한 대화 = 한 작업)",
        "isSticky": true,
        "commands": [
          {
            "name": "new",
            "description": "새 작업으로 시작"
          },
          {
            "name": "continue",
            "description": "기존 작업 이어가기: /continue <번호> <지시>"
          },
          {
            "name": "tasks",
            "description": "작업 목록"
          }
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "svnwt-session",
        "name": "svnwt",
        "displayName": "SVN Worktree 작업",
        "description": "svnwt 작업별 에이전트 세션"
      }
    ],
    "keybindings": [
      {
        "command": "svnwt.renameTask",
        "key": "f2",
        "when": "focusedView == svnwt.tasks && !inputFocus"
      },
      {
        "command": "svnwt.nextChange",
        "key": "alt+right",
        "when": "svnwt.diffNav"
      },
      {
        "command": "svnwt.prevChange",
        "key": "alt+left",
        "when": "svnwt.diffNav"
      },
      {
        "command": "svnwt.nextFile",
        "key": "shift+alt+right",
        "when": "svnwt.diffNav"
      },
      {
        "command": "svnwt.prevFile",
        "key": "shift+alt+left",
        "when": "svnwt.diffNav"
      },
      {
        "command": "svnwt.backToReview",
        "key": "escape",
        "when": "svnwt.diffNav && editorTextFocus && !findWidgetVisible && !suggestWidgetVisible && !editorHasSelection && !editorHasMultipleSelections && !parameterHintsVisible && !renameInputVisible && !inSnippetMode && !inlineChatVisible && !inlineSuggestionVisible && !markersNavigationVisible && !codeActionMenuVisible && !isComposing"
      },
      {
        "command": "svnwt.askAboutSelection",
        "key": "alt+q",
        "when": "svnwt.inTask && editorTextFocus"
      }
    ]
  },
  "enabledApiProposals": [
    "chatSessionsProvider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gimangi/svn-worktree"
  }
}
